---
import type { CollectionEntry } from 'astro:content';
import SectionTitle from './SectionTitle.astro';
import ViewCount from './ViewCount.astro';
import { GITHUB_AVATAR_URL, SITE_VIEW_BASELINE } from '../data/site';
import { postCardImage } from '../data/postImages';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const base = import.meta.env.BASE_URL;
const postSlug = (post: CollectionEntry<'posts'>) => post.data.slug ?? post.id.replace(/^wordpress\//, '');
const recent = [...posts]
  .sort((a, b) => (b.data.updatedAt ?? b.data.publishedAt).valueOf() - (a.data.updatedAt ?? a.data.publishedAt).valueOf())
  .slice(0, 5);
const commentCount = posts.reduce((total, post) => total + post.data.commentCount, 0);
const popularTags = [...posts.reduce((counts, post) => {
  post.data.tags.forEach((tag) => counts.set(tag, (counts.get(tag) ?? 0) + 1));
  return counts;
}, new Map<string, number>())]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 18);
const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---
<aside class="right-sidebar">
  <section class="author-card sidebar-panel"><div class="author-cover" style={`background-image: url('${base}images/blog-cover.jpg')`}></div><div class="author-body"><img class="author-avatar" src={GITHUB_AVATAR_URL} alt="Haibin's GitHub avatar" /><div class="author-name">haibin <span>UChicago</span></div><p class="author-bio">Systems research, LLMs, academic life, and ordinary days.</p><div class="author-stats"><div><strong>{posts.length}</strong><span>Articles</span></div><div><strong>{commentCount}</strong><span>Comments</span></div><div><strong><ViewCount scope="site" value={SITE_VIEW_BASELINE} /></strong><span>Views</span></div></div></div></section>
  <section class="sidebar-panel recent-panel"><SectionTitle>Recent Update</SectionTitle>{recent.map((post) => <a class="recent-item" href={`${base}posts/${postSlug(post)}/`}><img class="recent-thumb" src={postCardImage(post, base)} alt="" loading="lazy" decoding="async" /><div><strong>{post.data.title}</strong><time>{formatDate(post.data.updatedAt ?? post.data.publishedAt)}</time></div></a>)}</section>
  <section class="sidebar-panel tags-panel"><SectionTitle>Popular Tags</SectionTitle><div class="sidebar-tags">{popularTags.map(([tag, count]) => <a data-tag-filter={tag} href={`${base}?tag=${encodeURIComponent(tag)}`}>{tag}<small>{count}</small></a>)}</div></section>
  <section class="sidebar-panel passage-panel"><SectionTitle>Passage</SectionTitle><p>“The future is discovered through the work that survives contact with reality.”</p></section>
</aside>
