---
import type { CollectionEntry } from 'astro:content';
import '../styles/analytics-dashboard.css';

interface Props {
  posts: CollectionEntry<'posts'>[];
  articleCount: number;
}

const { posts, articleCount } = Astro.props;
const base = import.meta.env.BASE_URL;
const endpoint = (
  import.meta.env.PUBLIC_VIEW_COUNTER_URL
  || 'https://haibinblog-view-counter.haibinlai.workers.dev'
).replace(/\/$/, '');
const postSlug = (post: CollectionEntry<'posts'>) => post.data.slug ?? post.id.replace(/^wordpress\//, '');
const postMetadata = Object.fromEntries(posts.map((post) => {
  const slug = postSlug(post);
  return [`/posts/${slug}/`, {
    title: post.data.title,
    href: `${base}posts/${slug}/`,
    date: post.data.publishedAt.toISOString().slice(0, 10),
  }];
}));
---

<div class="analytics-dashboard">
  <header class="analytics-header">
    <div>
      <p class="analytics-kicker">GLHF / ANALYTICS</p>
      <h1>阅读数据</h1>
      <p>访问概览与最近 14 天的文章阅读变化</p>
    </div>
    <p class="analytics-snapshot" data-snapshot aria-live="polite">正在读取统计数据…</p>
  </header>

  <div class="analytics-overview" aria-label="阅读概览">
    <div><span>总浏览量</span><strong data-stat="site-total">—</strong><small>截至今日 00:00</small></div>
    <div><span>昨日浏览</span><strong data-stat="yesterday-views">—</strong><small data-yesterday-date>完整自然日</small></div>
    <div><span>文章总数</span><strong>{articleCount}</strong><small>公开正文文章</small></div>
    <div><span>篇均浏览</span><strong data-stat="average">—</strong><small>总浏览量 / 正文文章</small></div>
  </div>

  <section class="analytics-section" aria-labelledby="trends-title">
    <div class="analytics-section-heading">
      <div><p class="analytics-section-index">01 / ARTICLE TRENDS</p><h2 id="trends-title">最受关注的 5 篇</h2></div>
      <span>最近 14 个完整自然日</span>
    </div>
    <div class="analytics-trend-layout">
      <div class="analytics-chart analytics-line-chart" data-trend-chart aria-live="polite"><p>正在加载阅读趋势…</p></div>
      <ol class="analytics-legend" data-trend-legend aria-label="近 14 天阅读排名"></ol>
    </div>
  </section>

  <section class="analytics-section" aria-labelledby="daily-title">
    <div class="analytics-section-heading">
      <div><p class="analytics-section-index">02 / DAILY VIEWS</p><h2 id="daily-title">每日访问</h2></div>
      <span>全站访问量</span>
    </div>
    <div class="analytics-chart" data-daily-chart aria-live="polite"><p>正在加载逐日数据…</p></div>
  </section>

  <section class="analytics-section" aria-labelledby="popular-title">
    <div class="analytics-section-heading">
      <div><p class="analytics-section-index">03 / ALL-TIME</p><h2 id="popular-title">累计热门文章</h2></div>
      <span>截至今日 00:00</span>
    </div>
    <div class="analytics-table-wrap" data-popular-table aria-live="polite"><p>正在加载文章排名…</p></div>
  </section>

  <p class="analytics-note" data-tracking-note>逐日数据从 Cloudflare 统计启用后开始积累；历史总阅读量包含 WordPress 迁移基线。统计按芝加哥时间每日 00:00 更新。</p>
</div>

<script is:inline define:vars={{ endpoint, postMetadata, articleCount }}>
  (() => {
    const root = document.querySelector('.analytics-dashboard');
    if (!root) return;
    const colors = ['#a63642', '#217b72', '#b17b18', '#426ba9', '#7a607f'];
    const number = (value) => new Intl.NumberFormat('en-US').format(Number(value) || 0);
    const chicagoDate = () => {
      const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Chicago', year: 'numeric', month: '2-digit', day: '2-digit',
      }).formatToParts(new Date());
      const values = Object.fromEntries(parts.map(({ type, value }) => [type, value]));
      return `${values.year}-${values.month}-${values.day}`;
    };
    const metaFor = (path) => postMetadata[path] || {
      title: decodeURIComponent(path.split('/').filter(Boolean).pop() || path),
      href: '#',
      date: '',
    };
    const message = (value) => {
      root.querySelectorAll('[data-trend-chart], [data-daily-chart], [data-popular-table]').forEach((node) => {
        const paragraph = document.createElement('p');
        paragraph.textContent = value;
        node.replaceChildren(paragraph);
      });
      root.querySelector('[data-trend-legend]').replaceChildren();
    };

    const renderDaily = (daily) => {
      const wrap = root.querySelector('[data-daily-chart]');
      const max = Math.max(1, ...daily.map((item) => item.views));
      const chart = document.createElement('div');
      chart.className = 'analytics-bars';
      daily.forEach((item, index) => {
        const column = document.createElement('div');
        column.className = 'analytics-bar-column';
        column.title = `${item.date}: ${number(item.views)} 次`;
        column.setAttribute('aria-label', column.title);
        const value = document.createElement('span');
        value.className = 'analytics-bar-value';
        value.textContent = number(item.views);
        const bar = document.createElement('i');
        bar.className = 'analytics-bar';
        bar.style.height = `${Math.max(item.views ? 4 : 1, item.views / max * 100)}%`;
        const date = document.createElement('span');
        date.className = 'analytics-bar-date';
        date.textContent = item.date.slice(5);
        if (![0, 3, 6, 9, 13].includes(index)) date.classList.add('analytics-date-optional');
        column.append(value, bar, date);
        chart.append(column);
      });
      wrap.replaceChildren(chart);
    };

    const renderPopular = (items) => {
      const wrap = root.querySelector('[data-popular-table]');
      if (!items.length) {
        wrap.textContent = '暂无文章阅读数据。';
        return;
      }
      const table = document.createElement('table');
      table.className = 'analytics-table';
      table.innerHTML = '<thead><tr><th>排名</th><th>文章</th><th>浏览量</th><th>发布日期</th></tr></thead><tbody></tbody>';
      const body = table.querySelector('tbody');
      items.forEach((item, index) => {
        const meta = metaFor(item.path);
        const row = document.createElement('tr');
        const rank = document.createElement('td');
        rank.textContent = String(index + 1).padStart(2, '0');
        const title = document.createElement('td');
        const link = document.createElement('a');
        link.href = meta.href;
        link.textContent = meta.title;
        title.append(link);
        const views = document.createElement('td');
        views.textContent = number(item.views);
        const date = document.createElement('td');
        date.textContent = meta.date;
        row.append(rank, title, views, date);
        body.append(row);
      });
      wrap.replaceChildren(table);
    };

    const renderTrends = (daily, items) => {
      const wrap = root.querySelector('[data-trend-chart]');
      const legend = root.querySelector('[data-trend-legend]');
      if (!items.length) {
        wrap.textContent = '这 14 天还没有新的文章阅读数据。';
        legend.replaceChildren();
        return;
      }
      const width = Math.max(280, Math.round(wrap.clientWidth));
      const height = width < 500 ? 250 : 330;
      const pad = { left: width < 500 ? 32 : 42, right: 18, top: 22, bottom: 36 };
      const chartWidth = width - pad.left - pad.right;
      const chartHeight = height - pad.top - pad.bottom;
      const rawMax = Math.max(1, ...items.flatMap((item) => item.values));
      const roughTick = rawMax / 4;
      const magnitude = Math.pow(10, Math.floor(Math.log10(roughTick)));
      const normalizedTick = roughTick / magnitude;
      const tick = rawMax <= 4 ? 1 : (normalizedTick <= 1 ? 1 : normalizedTick <= 2 ? 2 : normalizedTick <= 3 ? 3 : normalizedTick <= 5 ? 5 : 10) * magnitude;
      const steps = rawMax <= 4 ? rawMax : 4;
      const max = tick * steps;
      const xFor = (index) => pad.left + index / Math.max(1, daily.length - 1) * chartWidth;
      const yFor = (value) => pad.top + chartHeight * (1 - value / max);
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.setAttribute('role', 'img');
      svg.setAttribute('aria-label', '近 14 天浏览最多的 5 篇文章，每日阅读量折线图');
      const grid = Array.from({ length: steps + 1 }, (_, step) => {
        const y = yFor(step * tick);
        return `<line x1="${pad.left}" y1="${y}" x2="${width - pad.right}" y2="${y}"/><text x="${pad.left - 10}" y="${y + 4}" text-anchor="end">${step * tick}</text>`;
      }).join('');
      const labels = daily.map((item, index) => {
        if (![0, 3, 6, 9, 13].includes(index)) return '';
        const anchor = index === 0 ? 'start' : index === 13 ? 'end' : 'middle';
        return `<text x="${xFor(index)}" y="${height - 7}" text-anchor="${anchor}">${item.date.slice(5)}</text>`;
      }).join('');
      svg.innerHTML = `<g class="analytics-grid">${grid}</g><g class="analytics-date-labels">${labels}</g>`;
      items.forEach((item, index) => {
        const values = daily.map((_, day) => Number(item.values[day]) || 0);
        const path = document.createElementNS(svg.namespaceURI, 'path');
        const segments = values.slice(1).map((value, day) => {
          const x1 = xFor(day);
          const x2 = xFor(day + 1);
          return `C ${x1 + (x2 - x1) * .35} ${yFor(values[day])} ${x2 - (x2 - x1) * .35} ${yFor(value)} ${x2} ${yFor(value)}`;
        });
        path.setAttribute('d', `M ${xFor(0)} ${yFor(values[0])} ${segments.join(' ')}`);
        path.setAttribute('stroke', colors[index]);
        path.setAttribute('class', 'analytics-series');
        path.dataset.series = String(index);
        svg.append(path);
        values.forEach((value, day) => {
          const circle = document.createElementNS(svg.namespaceURI, 'circle');
          circle.setAttribute('cx', xFor(day));
          circle.setAttribute('cy', yFor(value));
          circle.setAttribute('r', '3.5');
          circle.setAttribute('fill', colors[index]);
          circle.setAttribute('class', 'analytics-point');
          circle.dataset.series = String(index);
          const title = document.createElementNS(svg.namespaceURI, 'title');
          title.textContent = `${metaFor(item.path).title} · ${daily[day].date}: ${number(value)} 次`;
          circle.append(title);
          svg.append(circle);
        });
      });
      wrap.replaceChildren(svg);
      legend.replaceChildren(...items.map((item, index) => {
        const meta = metaFor(item.path);
        const row = document.createElement('li');
        const link = document.createElement('a');
        link.href = meta.href;
        const marker = document.createElement('span');
        marker.className = 'analytics-legend-marker';
        marker.style.backgroundColor = colors[index];
        const title = document.createElement('span');
        title.className = 'analytics-legend-title';
        title.textContent = meta.title;
        const total = document.createElement('strong');
        total.textContent = number(item.total);
        link.append(marker, title, total);
        row.append(link);
        row.addEventListener('mouseenter', () => {
          svg.querySelectorAll('[data-series]').forEach((node) => node.classList.toggle('analytics-dimmed', node.dataset.series !== String(index)));
        });
        row.addEventListener('mouseleave', () => {
          svg.querySelectorAll('[data-series]').forEach((node) => node.classList.remove('analytics-dimmed'));
        });
        return row;
      }));
    };

    let loadedDate = '';
    let lastDaily = null;
    let lastTrending = null;
    let loading = false;
    const load = async () => {
      if (loading) return;
      loading = true;
      try {
        const response = await fetch(`${endpoint}/stats?days=14`, { credentials: 'omit', mode: 'cors' });
        if (!response.ok) throw new Error(`statistics returned ${response.status}`);
        const data = await response.json();
        if (data.periodDays !== 14 || !data.snapshotDate || !data.overview || !Array.isArray(data.daily)) {
          throw new Error('outdated-statistics-service');
        }
        loadedDate = data.snapshotDate;
        root.querySelector('[data-snapshot]').textContent = `截至 ${data.snapshotDate} 00:00 · 芝加哥时间`;
        root.querySelector('[data-stat="site-total"]').textContent = number(data.overview.siteTotalAtMidnight);
        root.querySelector('[data-stat="yesterday-views"]').textContent = number(data.overview.yesterdayViews);
        root.querySelector('[data-yesterday-date]').textContent = data.periodEnd;
        root.querySelector('[data-stat="average"]').textContent = number(Math.round(data.overview.siteTotalAtMidnight / Math.max(1, articleCount)));
        if (data.trackingSince) {
          root.querySelector('[data-tracking-note]').textContent = `逐日数据始于 ${data.trackingSince}；历史总阅读量包含 WordPress 迁移基线。统计按芝加哥时间每日 00:00 更新。`;
        }
        lastDaily = data.daily;
        lastTrending = data.trending || [];
        renderTrends(lastDaily, lastTrending);
        renderDaily(data.daily);
        renderPopular(data.popularAtMidnight || []);
      } catch (error) {
        const outdated = error instanceof Error && error.message === 'outdated-statistics-service';
        root.querySelector('[data-snapshot]').textContent = outdated ? '统计服务待更新' : '暂时无法更新';
        message(outdated ? '统计服务尚未更新，图表将在服务升级后显示。' : '统计服务暂时不可用，请稍后刷新。');
      } finally {
        loading = false;
      }
    };
    const refreshAfterMidnight = () => {
      if (loadedDate && chicagoDate() !== loadedDate) load();
    };
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) refreshAfterMidnight();
    });
    if ('ResizeObserver' in window) {
      let previousWidth = 0;
      new ResizeObserver((entries) => {
        const width = Math.round(entries[0].contentRect.width);
        if (lastDaily && width !== previousWidth) renderTrends(lastDaily, lastTrending);
        previousWidth = width;
      }).observe(root.querySelector('[data-trend-chart]'));
    }
    window.setInterval(refreshAfterMidnight, 10000);
    load();
  })();
</script>
