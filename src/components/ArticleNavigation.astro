---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<aside class="left-navigation article-navigation sidebar-panel">
  <div class="panel-heading"><span>🗂️</span><strong>Table of Contents</strong><span class="panel-menu">☰</span></div>
  <nav class="nav-tree article-outline" aria-label="Table of contents">
    <a class="depth-1 is-active" href="#article-title" data-heading-id="article-title"><span>{title}</span></a>
  </nav>
</aside>

<script>
  const navigation = document.querySelector<HTMLElement>('.article-navigation');

  if (navigation) {
    const tree = navigation.querySelector<HTMLElement>('.article-outline');
    const articleHeadings = [...document.querySelectorAll<HTMLElement>('.prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6')];
    const usedIds = new Set<string>(['article-title']);

    articleHeadings.forEach((heading, index) => {
      let id = heading.id || heading.textContent
        ?.normalize('NFKC')
        .trim()
        .toLowerCase()
        .replace(/[^\p{Letter}\p{Number}\s-]/gu, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-');
      if (!id) id = `section-${index + 1}`;

      const originalId = id;
      let suffix = 2;
      while (usedIds.has(id)) id = `${originalId}-${suffix++}`;
      usedIds.add(id);
      heading.id = id;

      const link = document.createElement('a');
      const headingLevel = Number(heading.tagName.slice(1));
      link.className = `depth-${Math.max(2, headingLevel)}`;
      link.href = `#${id}`;
      link.dataset.headingId = id;
      const label = document.createElement('span');
      label.textContent = heading.textContent?.trim() || `Section ${index + 1}`;
      link.append(label);
      tree?.append(link);
    });

    const links = [...navigation.querySelectorAll<HTMLAnchorElement>('[data-heading-id]')];
    const sections = links
      .map((link) => ({ link, section: document.getElementById(link.dataset.headingId ?? '') }))
      .filter((item): item is { link: HTMLAnchorElement; section: HTMLElement } => Boolean(item.section));
    const desktopSidebar = window.matchMedia('(min-width: 1025px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeLink: HTMLAnchorElement | null = null;
    let scheduled = false;

    const revealActiveLink = (link: HTMLAnchorElement) => {
      if (!tree) return;
      const treeRect = tree.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();
      const edge = 12;
      if (linkRect.top >= treeRect.top + edge && linkRect.bottom <= treeRect.bottom - edge) return;

      const linkTop = tree.scrollTop + linkRect.top - treeRect.top;
      const target = Math.max(0, linkTop - (tree.clientHeight - linkRect.height) / 2);
      tree.scrollTo({ top: target, behavior: reduceMotion ? 'auto' : 'smooth' });
    };

    const setActiveLink = (nextLink: HTMLAnchorElement | undefined) => {
      if (!nextLink || nextLink === activeLink) return;
      links.forEach((link) => {
        const isActive = link === nextLink;
        link.classList.toggle('is-active', isActive);
        if (isActive) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      activeLink = nextLink;
      revealActiveLink(nextLink);
    };

    const updateActiveHeading = () => {
      if (!desktopSidebar.matches) {
        scheduled = false;
        return;
      }

      const headerHeight = document.querySelector<HTMLElement>('.site-header')?.getBoundingClientRect().height ?? 62;
      const readingLine = headerHeight + 58;
      let active = sections[0];

      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        active = sections[sections.length - 1];
      } else {
        for (const item of sections) {
          if (item.section.getBoundingClientRect().top <= readingLine) active = item;
          else break;
        }
      }

      setActiveLink(active?.link);
      scheduled = false;
    };

    const scheduleUpdate = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(updateActiveHeading);
    };

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate, { passive: true });
    window.addEventListener('hashchange', scheduleUpdate);
    window.addEventListener('pageshow', scheduleUpdate);

    if (window.location.hash) {
      try {
        const requested = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
        requestAnimationFrame(() => requested?.scrollIntoView());
      } catch {
        // Ignore malformed URL fragments and keep the article readable.
      }
    }
    updateActiveHeading();
  }
</script>
