---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  currentSlug?: string;
}

const { posts, currentSlug } = Astro.props;
const base = import.meta.env.BASE_URL;
const postSlug = (post: CollectionEntry<'posts'>) => post.data.slug ?? post.id.replace(/^wordpress\//, '');
---
<aside class="left-navigation sidebar-panel">
  <div class="panel-heading"><span>🗂️</span><strong>Article Navigation</strong><span class="panel-menu">☰</span></div>
  <nav class="nav-tree" aria-label="All articles">
    <a
      class:list={{ 'nav-tree-root': true, 'is-active': !currentSlug }}
      href={base}
      data-nav-root
      aria-current={!currentSlug ? 'location' : undefined}
    ><span>All writing</span><small>{posts.length}</small></a>
    {posts.map((post) => {
      const slug = postSlug(post);
      return (
      <a
        class:list={{ 'is-active': slug === currentSlug }}
        href={`${base}posts/${slug}/`}
        data-post-slug={slug}
        aria-current={slug === currentSlug ? 'page' : undefined}
      >
        <span>{post.data.title}</span>
      </a>
      );
    })}
  </nav>
</aside>

{currentSlug && (
  <script is:inline>
    (() => {
      const navigation = document.querySelector('.left-navigation .nav-tree');
      const current = navigation?.querySelector('[aria-current="page"]');
      if (navigation && current) {
        navigation.scrollTop = current.offsetTop - navigation.clientHeight / 2 + current.clientHeight / 2;
      }
    })();
  </script>
)}
