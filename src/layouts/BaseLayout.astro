---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Haibin's Blog",
  description = 'Research notes, life fragments, and work in progress.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Haibin's Blog home"><img src={`${base}images/logo.png`} alt="" />Haibin's blog</a>
      <div class="header-tools"><label class="search-box"><span aria-hidden="true">⌕</span><input type="search" placeholder="Enter keywords to search" aria-label="Search" /></label><button class="theme-toggle" type="button" aria-label="Toggle dark mode">☼</button><nav aria-label="Primary navigation"><a href={base}>Homepage⌄</a><a href={`${base}moments/`}>Moments</a><a href={`${base}about/`}>GLHF⌄</a><a href={`${base}about/`}>My Friends</a><a href="https://github.com/HaibinLai" rel="me">My Github</a><a href="https://haibinlai.github.io" rel="me">My CV</a></nav></div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>Haibin Lai</span>
      <span>Research, notes, and ordinary days.</span>
    </footer>
    <script is:inline>
      const toggle = document.querySelector('.theme-toggle');
      if (localStorage.getItem('haibin-theme') === 'dark') document.documentElement.classList.add('dark');
      toggle?.addEventListener('click', () => { document.documentElement.classList.toggle('dark'); localStorage.setItem('haibin-theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light'); });
    </script>
  </body>
</html>
