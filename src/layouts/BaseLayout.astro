---
import '../styles/global.css';
import ViewTracker from '../components/ViewTracker.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'zh-CN' | 'en';
  alternates?: Array<{
    lang: 'zh-CN' | 'en';
    href: string;
  }>;
}

const {
  title = "Haibin's Blog",
  description = 'Research notes, life fragments, and work in progress.',
  lang = 'zh-CN',
  alternates = [],
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}images/logo.png`} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
    ))}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Haibin's Blog home"><img src={`${base}images/logo.png`} alt="" />Haibin's blog</a>
      <div class="header-tools">
        <label class="search-box"><span aria-hidden="true">⌕</span><input type="search" placeholder="Enter keywords to search" aria-label="Search" /></label>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode">☼</button>
        <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-controls="site-navigation" aria-expanded="false">☰</button>
        <nav id="site-navigation" class="primary-nav" aria-label="Primary navigation">
          <div class="nav-group">
            <a class="nav-parent" href={base}>Homepage <span aria-hidden="true">⌄</span></a>
            <div class="nav-submenu" aria-label="Homepage categories">
              <a href={`${base}?category=CPP`}>CPP</a>
              <a href={`${base}?category=OS`}>OS</a>
              <a href={`${base}?category=Compilers`}>编译器</a>
              <a href={`${base}?category=${encodeURIComponent('复盘')}`}>复盘</a>
            </div>
          </div>
          <a href={`${base}moments/`}>Moments</a>
          <div class="nav-group nav-group-wide">
            <a class="nav-parent" href="https://haibinlai.github.io/self_thinking/">GLHF <span aria-hidden="true">⌄</span></a>
            <div class="nav-submenu" aria-label="GLHF tools and statistics">
              <span class="nav-submenu-label">Tools</span>
              <a href="https://haibinlai.github.io/self_thinking/">Caseboard</a>
              <a href="https://www.haibinlaiblog.top/index.php/clipboard/">剪贴板</a>
              <a href="https://www.haibinlaiblog.top/index.php/todo-list/">Todo List</a>
              <span class="nav-submenu-label">Statistics</span>
              <a href="https://www.haibinlaiblog.top/index.php/sum-of-the-blog/">Sum of the Blog</a>
              <a href="https://www.haibinlaiblog.top/index.php/%e9%98%85%e8%af%bb%e8%b6%8b%e5%8a%bf/">阅读趋势</a>
              <a href={`${base}posts/caseboard-xiang-zhen-tan-yi-yang-zuo-ke-yan/`}>Caseboard 文章</a>
            </div>
          </div>
          <a href={`${base}about/`}>My Friends</a>
          <a href="https://github.com/HaibinLai" rel="me">My Github</a>
          <a href="https://haibinlai.github.io" rel="me">My CV</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>Haibin Lai</span>
      <span>Research, notes, and ordinary days.</span>
    </footer>
    <script is:inline>
      (() => {
        const themeToggle = document.querySelector('.theme-toggle');
        const menuToggle = document.querySelector('.menu-toggle');
        const header = document.querySelector('.site-header');
        const closeMenu = () => {
          header?.classList.remove('is-menu-open');
          menuToggle?.setAttribute('aria-expanded', 'false');
        };

        if (localStorage.getItem('haibin-theme') === 'dark') document.documentElement.classList.add('dark');
        themeToggle?.addEventListener('click', () => {
          document.documentElement.classList.toggle('dark');
          localStorage.setItem('haibin-theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
        });
        menuToggle?.addEventListener('click', () => {
          const open = header?.classList.toggle('is-menu-open') ?? false;
          menuToggle.setAttribute('aria-expanded', String(open));
        });
        header?.querySelectorAll('nav a').forEach((link) => link.addEventListener('click', closeMenu));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeMenu();
        });
      })();
    </script>
    <ViewTracker />
  </body>
</html>
