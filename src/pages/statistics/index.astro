---
import { getCollection } from 'astro:content';
import AnalyticsDashboard from '../../components/AnalyticsDashboard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const fragmentCategories = new Set(['fragments', 'life-fragments']);
const posts = await getCollection('posts', ({ data }) => !data.draft && ![data.category, ...data.categories]
  .some((category) => fragmentCategories.has(category.trim().toLowerCase())));
---

<BaseLayout title="阅读统计 · Haibin's Blog" description="Haibin's Blog 阅读统计与热门文章。">
  <main class="analytics-page content-shell">
    <AnalyticsDashboard mode="statistics" posts={posts} />
  </main>
</BaseLayout>
