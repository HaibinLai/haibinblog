---
import { getCollection } from 'astro:content';
import AnalyticsDashboard from '../../components/AnalyticsDashboard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const fragmentCategories = new Set(['fragments', 'life-fragments']);
const posts = await getCollection('posts', ({ data }) => !data.draft);
const articleCount = posts.filter(({ data }) => ![data.category, ...data.categories]
  .some((category) => fragmentCategories.has(category.trim().toLowerCase()))).length;
---

<BaseLayout title="阅读数据 · Haibin's Blog" description="Haibin's Blog 阅读统计、文章趋势与热门文章。">
  <main class="analytics-page content-shell">
    <AnalyticsDashboard posts={posts} articleCount={articleCount} />
  </main>
</BaseLayout>
