---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const routes = new Map<string, string>();

  for (const post of posts) {
    const destination = `/posts/${post.data.slug ?? post.id.replace(/^wordpress\//, '')}/`;
    const aliases = [post.data.legacySlug, ...post.data.oldSlugs]
      .filter((slug): slug is string => Boolean(slug))
      .map((slug) => slug.replace(/^\/+|\/+$/g, ''));

    for (const alias of aliases) {
      const existing = routes.get(alias);
      if (existing && existing !== destination) {
        throw new Error(`Legacy route collision for ${alias}: ${existing} and ${destination}`);
      }
      routes.set(alias, destination);
    }
  }

  return [...routes].map(([slug, destination]) => ({
    params: { slug },
    props: { destination },
  }));
}

const { destination } = Astro.props;
const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith('/') ? base : `${base}/`;
const target = `${normalizedBase}${destination.replace(/^\//, '')}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}images/logo.png`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <title>文章已迁移</title>
  </head>
  <body>
    <p>文章已迁移，正在跳转到 <a href={target}>新地址</a>。</p>
  </body>
</html>
