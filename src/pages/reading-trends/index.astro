---
const target = `${import.meta.env.BASE_URL}statistics/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <title>阅读趋势已并入阅读数据</title>
  </head>
  <body>
    <p>阅读趋势已并入<a href={target}>阅读数据</a>。</p>
  </body>
</html>
