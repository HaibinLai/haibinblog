---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GITHUB_AVATAR_URL } from '../../data/site';

const base = import.meta.env.BASE_URL;
const fragments = (await getCollection(
  'posts',
  ({ data }) => !data.draft && [data.category, ...data.categories]
    .some((category) => ['fragments', 'life-fragments'].includes(category.toLowerCase())),
)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const decodeAttribute = (value: string) => value
  .replaceAll('&amp;', '&')
  .replaceAll('&quot;', '"')
  .replaceAll('&#039;', "'")
  .replaceAll('&lt;', '<')
  .replaceAll('&gt;', '>');

const readAttribute = (tag: string, name: string) => {
  const quoted = tag.match(new RegExp(`\\s${name}=["']([^"']*)["']`, 'i'));
  const unquoted = tag.match(new RegExp(`\\s${name}=([^\\s>]+)`, 'i'));
  return decodeAttribute(quoted?.[1] ?? unquoted?.[1] ?? '');
};

const normaliseImageUrl = (value: string) => value.replace(/\|\d+(?:x\d+)?$/i, '');

const extractFragment = (source = '', featuredImage = '') => {
  const images: Array<{ src: string; alt: string }> = [];

  const addImage = (src: string, alt: string) => {
    const normalised = normaliseImageUrl(src);
    if (normalised && !images.some((image) => image.src === normalised)) {
      images.push({ src: normalised, alt });
    }
  };

  if (featuredImage) addImage(featuredImage, '');

  const collectImages = (markup: string) => {
    for (const match of markup.matchAll(/<img\b[^>]*>/gi)) {
      addImage(readAttribute(match[0], 'src'), readAttribute(match[0], 'alt'));
    }
  };

  let html = source.replace(/<figure\b[^>]*>[\s\S]*?<\/figure>/gi, (figure) => {
    collectImages(figure);
    return '';
  });

  html = html.replace(/<img\b[^>]*>/gi, (image) => {
    collectImages(image);
    return '';
  });

  html = html
    .replace(/<a\b[^>]*>\s*<\/a>/gi, '')
    .replace(/<p\b[^>]*>\s*<\/p>/gi, '')
    .trim();

  return { html, images: images.slice(0, 9) };
};

const siteTimeZone = 'Asia/Shanghai';
const monthLabel = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: '2-digit',
  timeZone: siteTimeZone,
});
const dateLabel = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: siteTimeZone,
});

const postSlug = (post: (typeof fragments)[number]) => post.data.slug ?? post.id.replace(/^wordpress\//, '');
const authorLabel = (author: string) => author.toLowerCase() === 'gb' ? 'Haibin' : author;
const groups = fragments.reduce<Array<{
  month: string;
  posts: Array<(typeof fragments)[number] & { fragment: ReturnType<typeof extractFragment> }>;
}>>((result, post) => {
  const month = monthLabel.format(post.data.publishedAt).replace('-', '.');
  const entry = {
    ...post,
    fragment: extractFragment(post.rendered?.html ?? post.body ?? '', post.data.featuredImage),
  };
  const current = result.at(-1);

  if (!current || current.month !== month) result.push({ month, posts: [entry] });
  else current.posts.push(entry);

  return result;
}, []);
---

<BaseLayout title="Moments | Haibin's Blog" description="Life fragments and small records from Haibin Lai.">
  <section class="fragments-page content-shell">
    <header class="fragments-header">
      <h1>Moments</h1>
    </header>

    <div class="fragments-list">
      {groups.map((group) => (
        <>
          <div class="fragment-month">{group.month}</div>
          {group.posts.map((post) => {
            const href = `${base}posts/${postSlug(post)}/`;
            const visibleComments = post.data.comments.slice(-8);
            const commentsId = `fragment-comments-${post.data.wordpressId ?? post.id}`;
            return (
              <article class="fragment-item">
                <a class="fragment-avatar" href={base} aria-label="Haibin">
                  <img src={GITHUB_AVATAR_URL} loading="lazy" alt="Haibin's GitHub avatar" />
                </a>

                <div class="fragment-body">
                  <div class="fragment-author"><a href={base}>{authorLabel(post.data.author)}</a></div>
                  {(post.data.title || post.fragment.html) && (
                    <div class="fragment-content-wrap">
                      {post.data.title && <h2 class="fragment-title"><a href={href}>{post.data.title}</a></h2>}
                      {post.fragment.html && <div class="fragment-content" data-fragment-content set:html={post.fragment.html} />}
                      {post.fragment.html && <button type="button" class="fragment-expand" aria-expanded="false">展开</button>}
                    </div>
                  )}

                  {post.fragment.images.length > 0 && (
                    <div class="fragment-media" data-count={post.fragment.images.length}>
                      {post.fragment.images.map((image) => (
                        <button type="button" class="fragment-thumb" data-fragment-image={image.src} aria-label="查看大图">
                          <img src={image.src} loading="lazy" alt={image.alt || post.data.title} />
                        </button>
                      ))}
                    </div>
                  )}

                  <div class="fragment-meta">
                    <a href={href}>
                      <time datetime={post.data.publishedAt.toISOString()}>{dateLabel.format(post.data.publishedAt)}</time>
                    </a>
                    {visibleComments.length > 0
                      ? <a href={`#${commentsId}`}>{post.data.commentCount} {post.data.commentCount === 1 ? 'Comment' : 'Comments'}</a>
                      : <span>{post.data.commentCount} Comments</span>}
                  </div>

                  {visibleComments.length > 0 && (
                    <div class="fragment-comments" id={commentsId}>
                      {visibleComments.map((comment) => (
                        <div class="fragment-comment">
                          <span class="fragment-comment-author">{comment.author}</span>
                          {comment.replyTo && <span class="fragment-comment-reply">Reply to {comment.replyTo}</span>}
                          <span class="fragment-comment-content">{comment.content}</span>
                        </div>
                      ))}
                      {post.data.comments.length > visibleComments.length && (
                        <a class="fragment-comments-more" href={`${href}#comments`}>View all comments</a>
                      )}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </>
      ))}
    </div>
  </section>

  <dialog class="fragment-lightbox" aria-label="图片预览">
    <button class="fragment-lightbox-close" type="button" aria-label="关闭">&times;</button>
    <img alt="" />
  </dialog>
</BaseLayout>

<script>
  const initialiseFragments = () => {
    document.querySelectorAll<HTMLElement>('[data-fragment-content]').forEach((content) => {
      const button = content.parentElement?.querySelector<HTMLButtonElement>('.fragment-expand');
      if (!button || content.scrollHeight <= content.clientHeight + 2) return;

      button.classList.add('is-visible');
      button.addEventListener('click', () => {
        const expanded = content.classList.toggle('is-expanded');
        button.setAttribute('aria-expanded', String(expanded));
        button.textContent = expanded ? '收起' : '展开';
      });
    });

    const lightbox = document.querySelector<HTMLDialogElement>('.fragment-lightbox');
    const lightboxImage = lightbox?.querySelector<HTMLImageElement>('img');
    const closeButton = lightbox?.querySelector<HTMLButtonElement>('.fragment-lightbox-close');

    document.querySelectorAll<HTMLButtonElement>('[data-fragment-image]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!lightbox || !lightboxImage || !button.dataset.fragmentImage) return;
        const thumbnail = button.querySelector<HTMLImageElement>('img');
        lightboxImage.src = button.dataset.fragmentImage;
        lightboxImage.alt = thumbnail?.alt ?? '';
        lightbox.showModal();
      });
    });

    closeButton?.addEventListener('click', () => lightbox?.close());
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });
    lightbox?.addEventListener('close', () => lightboxImage?.removeAttribute('src'));
  };

  initialiseFragments();
</script>

<style>
  .fragments-page {
    width: min(760px, calc(100% - 32px));
    padding: 28px 0 80px;
  }

  .fragments-header {
    padding: 1.2rem 0 1rem 4.2rem;
  }

  .fragments-header h1 {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .fragments-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .fragment-month {
    position: sticky;
    top: 4.6rem;
    z-index: 2;
    align-self: flex-start;
    margin: .8rem 0 .1rem 4rem;
    padding: .18rem .55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--page) 88%, var(--surface));
    color: var(--muted);
    font-size: .78rem;
    line-height: 1.5;
  }

  .fragment-item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: .95rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }

  .fragment-avatar,
  .fragment-avatar img {
    display: block;
    width: 3rem;
    height: 3rem;
  }

  .fragment-avatar img {
    border-radius: 6px;
    object-fit: cover;
  }

  .fragment-body {
    min-width: 0;
  }

  .fragment-author {
    margin-top: -.1rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .fragment-author a,
  .fragment-expand,
  .fragment-comment-author,
  .fragment-comment-reply,
  .fragment-comments-more {
    color: #50618a;
  }

  .fragment-title {
    margin: .25rem 0 .1rem;
    font-size: .98rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .fragment-content-wrap {
    margin-top: .35rem;
  }

  .fragment-content {
    max-height: 5.9em;
    overflow: hidden;
    color: var(--ink);
    font-size: .98rem;
    line-height: 1.72;
    overflow-wrap: anywhere;
  }

  .fragment-content.is-expanded {
    max-height: none;
  }

  .fragment-content :global(p) {
    margin: 0 0 .4rem;
  }

  .fragment-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .fragment-content :global(a) {
    color: var(--accent-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .fragment-content :global(h1),
  .fragment-content :global(h2),
  .fragment-content :global(h3),
  .fragment-content :global(h4) {
    margin: .8em 0 .35em;
    font-size: 1.02rem;
    line-height: 1.45;
  }

  .fragment-content :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: .82rem;
  }

  .fragment-expand {
    display: none;
    margin: .25rem 0 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: .92rem;
  }

  .fragment-expand.is-visible {
    display: inline-flex;
  }

  .fragment-media {
    display: grid;
    gap: .32rem;
    width: min(100%, 31rem);
    margin-top: .55rem;
  }

  .fragment-media[data-count='1'] {
    grid-template-columns: 1fr;
    width: min(13.5rem, 70%);
  }

  .fragment-media[data-count='2'],
  .fragment-media[data-count='4'] {
    grid-template-columns: repeat(2, 1fr);
    width: min(20rem, 86%);
  }

  .fragment-media:not([data-count='1']):not([data-count='2']):not([data-count='4']) {
    grid-template-columns: repeat(3, 1fr);
  }

  .fragment-thumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 2px;
    background: color-mix(in srgb, var(--line) 40%, transparent);
    cursor: zoom-in;
  }

  .fragment-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .16s ease, filter .16s ease;
  }

  .fragment-thumb:hover img {
    filter: brightness(.96);
    transform: scale(1.018);
  }

  .fragment-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem;
    margin-top: .7rem;
    color: var(--muted);
    font-size: .86rem;
  }

  .fragment-meta a:hover {
    color: #50618a;
  }

  .fragment-comments {
    margin-top: .55rem;
    padding: .5rem .65rem;
    background: color-mix(in srgb, var(--line) 24%, transparent);
    color: var(--ink);
    font-size: .88rem;
    line-height: 1.62;
  }

  .fragment-comment + .fragment-comment {
    margin-top: .25rem;
  }

  .fragment-comment-author {
    font-weight: 650;
  }

  .fragment-comment-author::after,
  .fragment-comment-reply::after {
    margin-right: .25rem;
    content: ':';
  }

  .fragment-comment-reply {
    margin-left: .3rem;
  }

  .fragment-comment-content {
    white-space: pre-line;
  }

  .fragment-comments-more {
    display: inline-block;
    margin-top: .35rem;
  }

  .fragment-lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .fragment-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fragment-lightbox::backdrop {
    background: rgba(0, 0, 0, .9);
  }

  .fragment-lightbox img {
    max-width: 94vw;
    max-height: 94vh;
    object-fit: contain;
  }

  .fragment-lightbox-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 1;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, .16);
    color: white;
    cursor: pointer;
    font-size: 1.4rem;
    line-height: 1;
  }

  @media (max-width: 768px) {
    .fragments-page {
      width: min(100% - 24px, 760px);
      padding-top: 18px;
    }

    .fragments-header {
      padding-left: 0;
    }

    .fragment-item {
      grid-template-columns: 2.65rem minmax(0, 1fr);
      gap: .75rem;
    }

    .fragment-avatar,
    .fragment-avatar img {
      width: 2.65rem;
      height: 2.65rem;
    }

    .fragment-media {
      width: 100%;
    }

    .fragment-month {
      top: 4rem;
      margin-left: 3.4rem;
    }
  }
</style>
