---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GITHUB_AVATAR_URL } from '../../data/site';

const base = import.meta.env.BASE_URL;
const fragments = (await getCollection(
  'posts',
  ({ data }) => !data.draft && [data.category, ...data.categories]
    .some((category) => ['fragments', 'life-fragments'].includes(category.toLowerCase())),
)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const decodeAttribute = (value: string) => value
  .replaceAll('&amp;', '&')
  .replaceAll('&quot;', '"')
  .replaceAll('&#039;', "'")
  .replaceAll('&lt;', '<')
  .replaceAll('&gt;', '>');

const readAttribute = (tag: string, name: string) => {
  const quoted = tag.match(new RegExp(`\\s${name}=["']([^"']*)["']`, 'i'));
  const unquoted = tag.match(new RegExp(`\\s${name}=([^\\s>]+)`, 'i'));
  return decodeAttribute(quoted?.[1] ?? unquoted?.[1] ?? '');
};

const normaliseImageUrl = (value: string) => value.replace(/\|\d+(?:x\d+)?$/i, '');

const extractFragment = (source = '', featuredImage = '') => {
  const images: Array<{ src: string; alt: string }> = [];

  const addImage = (src: string, alt: string) => {
    const normalised = normaliseImageUrl(src);
    if (normalised && !images.some((image) => image.src === normalised)) {
      images.push({ src: normalised, alt });
    }
  };

  if (featuredImage) addImage(featuredImage, '');

  const collectImages = (markup: string) => {
    for (const match of markup.matchAll(/<img\b[^>]*>/gi)) {
      addImage(readAttribute(match[0], 'src'), readAttribute(match[0], 'alt'));
    }
  };

  let html = source.replace(/<figure\b[^>]*>[\s\S]*?<\/figure>/gi, (figure) => {
    collectImages(figure);
    return '';
  });

  html = html.replace(/<img\b[^>]*>/gi, (image) => {
    collectImages(image);
    return '';
  });

  html = html
    .replace(/<a\b[^>]*>\s*<\/a>/gi, '')
    .replace(/<p\b[^>]*>\s*<\/p>/gi, '')
    .trim();

  return { html, images: images.slice(0, 9) };
};

const siteTimeZone = 'Asia/Shanghai';
const monthLabel = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  timeZone: siteTimeZone,
});
const dateLabel = new Intl.DateTimeFormat('zh-CN', {
  month: 'long',
  day: 'numeric',
  timeZone: siteTimeZone,
});
const fullDateLabel = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: '2-digit',
  timeZone: siteTimeZone,
});

const postSlug = (post: (typeof fragments)[number]) => post.data.slug ?? post.id.replace(/^wordpress\//, '');
const authorLabel = (author: string) => ['gb', 'haibin'].includes(author.trim().toLowerCase()) ? 'Haibin' : author;
const groups = fragments.reduce<Array<{
  month: string;
  posts: Array<(typeof fragments)[number] & { fragment: ReturnType<typeof extractFragment> }>;
}>>((result, post) => {
  const month = monthLabel.format(post.data.publishedAt);
  const entry = {
    ...post,
    fragment: extractFragment(post.rendered?.html ?? post.body ?? '', post.data.featuredImage),
  };
  const current = result.at(-1);

  if (!current || current.month !== month) result.push({ month, posts: [entry] });
  else current.posts.push(entry);

  return result;
}, []);
---

<BaseLayout title="Moments | Haibin's Blog" description="Life fragments and small records from Haibin Lai.">
  <section class="fragments-page content-shell">
    <header class="moments-profile">
      <div class="moments-cover" style={`background-image: url('${base}images/blog-cover.jpg')`}>
        <h1>Moments</h1>
        <div class="moments-identity">
          <strong>haibin</strong>
          <img src={GITHUB_AVATAR_URL} alt="Haibin's GitHub avatar" fetchpriority="high" />
        </div>
      </div>
      <p class="moments-signature">Systems research, LLMs, academic life, and ordinary days.</p>
    </header>

    <div class="fragments-list">
      {groups.map((group) => (
        <>
          <div class="fragment-month">{group.month}</div>
          {group.posts.map((post) => {
            const href = `${base}posts/${postSlug(post)}/`;
            const visibleComments = post.data.comments.slice(-8);
            const commentsId = `fragment-comments-${post.data.wordpressId ?? post.id}`;
            return (
              <article class="fragment-item">
                <a class="fragment-avatar" href={base} aria-label="Haibin">
                  <img src={GITHUB_AVATAR_URL} loading="lazy" alt="Haibin's GitHub avatar" />
                </a>

                <div class="fragment-body">
                  <div class="fragment-author"><a href={base}>{authorLabel(post.data.author)}</a></div>
                  {(post.data.title || post.fragment.html) && (
                    <div class="fragment-content-wrap">
                      {post.data.title && <h2 class="fragment-title"><a href={href}>{post.data.title}</a></h2>}
                      {post.fragment.html && <div class="fragment-content" data-fragment-content set:html={post.fragment.html} />}
                      {post.fragment.html && <button type="button" class="fragment-expand" aria-expanded="false">全文</button>}
                    </div>
                  )}

                  {post.fragment.images.length > 0 && (
                    <div class="fragment-media" data-count={post.fragment.images.length}>
                      {post.fragment.images.map((image) => (
                        <button type="button" class="fragment-thumb" data-fragment-image={image.src} aria-label="查看大图">
                          <img src={image.src} loading="lazy" alt={image.alt || post.data.title} />
                        </button>
                      ))}
                    </div>
                  )}

                  <div class="fragment-meta">
                    <div class="fragment-meta-copy">
                      <a href={href}>
                        <time datetime={post.data.publishedAt.toISOString()} title={fullDateLabel.format(post.data.publishedAt)}>
                          {dateLabel.format(post.data.publishedAt)}
                        </time>
                      </a>
                      <a href={href}>详情</a>
                    </div>
                    <a class="fragment-action" href={href} aria-label={`查看《${post.data.title}》全文`} title="阅读全文">
                      <span aria-hidden="true">••</span>
                    </a>
                  </div>

                  {visibleComments.length > 0 && (
                    <div class="fragment-comments" id={commentsId}>
                      {visibleComments.map((comment) => (
                        <div class="fragment-comment">
                          <span class="fragment-comment-author">{comment.author}</span>
                          {comment.replyTo && <span class="fragment-comment-reply">回复 {comment.replyTo}</span>}
                          <span class="fragment-comment-colon">：</span>
                          <span class="fragment-comment-content">{comment.content}</span>
                        </div>
                      ))}
                      {post.data.comments.length > visibleComments.length && (
                        <a class="fragment-comments-more" href={`${href}#comments`}>查看全部 {post.data.commentCount} 条评论</a>
                      )}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </>
      ))}
    </div>
  </section>

  <dialog class="fragment-lightbox" aria-label="图片预览">
    <button class="fragment-lightbox-close" type="button" aria-label="关闭">&times;</button>
    <img alt="" />
  </dialog>
</BaseLayout>

<script>
  const initialiseFragments = () => {
    document.querySelectorAll<HTMLElement>('[data-fragment-content]').forEach((content) => {
      const button = content.parentElement?.querySelector<HTMLButtonElement>('.fragment-expand');
      if (!button || content.scrollHeight <= content.clientHeight + 2) return;

      button.classList.add('is-visible');
      button.addEventListener('click', () => {
        const expanded = content.classList.toggle('is-expanded');
        button.setAttribute('aria-expanded', String(expanded));
        button.textContent = expanded ? '收起' : '全文';
      });
    });

    const lightbox = document.querySelector<HTMLDialogElement>('.fragment-lightbox');
    const lightboxImage = lightbox?.querySelector<HTMLImageElement>('img');
    const closeButton = lightbox?.querySelector<HTMLButtonElement>('.fragment-lightbox-close');

    document.querySelectorAll<HTMLButtonElement>('[data-fragment-image]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!lightbox || !lightboxImage || !button.dataset.fragmentImage) return;
        const thumbnail = button.querySelector<HTMLImageElement>('img');
        lightboxImage.src = button.dataset.fragmentImage;
        lightboxImage.alt = thumbnail?.alt ?? '';
        lightbox.showModal();
      });
    });

    closeButton?.addEventListener('click', () => lightbox?.close());
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });
    lightbox?.addEventListener('close', () => lightboxImage?.removeAttribute('src'));
  };

  initialiseFragments();
</script>

<style>
  .fragments-page {
    --moment-blue: #576b95;
    width: min(720px, calc(100% - 32px));
    margin-top: 28px;
    padding: 0 0 56px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--line) 86%, transparent);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 12px 38px rgba(27, 42, 55, .08);
  }

  :global(.dark) .fragments-page {
    --moment-blue: #9caed4;
  }

  .moments-profile {
    border-bottom: 1px solid color-mix(in srgb, var(--line) 65%, transparent);
  }

  .moments-cover {
    position: relative;
    height: 248px;
    background-position: center;
    background-size: cover;
  }

  .moments-cover::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, .08) 38%, rgba(0, 0, 0, .58) 100%);
    content: '';
  }

  .moments-cover h1 {
    position: absolute;
    z-index: 1;
    top: 18px;
    left: 24px;
    margin: 0;
    color: white;
    font-size: 1.06rem;
    font-weight: 600;
    letter-spacing: .04em;
    line-height: 1.35;
    text-shadow: 0 1px 8px rgba(0, 0, 0, .32);
  }

  .moments-identity {
    position: absolute;
    z-index: 1;
    right: 24px;
    bottom: -36px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .moments-identity strong {
    color: white;
    font-size: 1.18rem;
    font-weight: 650;
    transform: translateY(-21px);
    text-shadow: 0 1px 8px rgba(0, 0, 0, .7);
  }

  .moments-identity img {
    display: block;
    width: 84px;
    height: 84px;
    border: 3px solid var(--surface);
    border-radius: 7px;
    background: var(--surface);
    object-fit: cover;
  }

  .moments-signature {
    min-height: 66px;
    margin: 0;
    padding: 44px 24px 13px;
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.5;
    text-align: right;
  }

  .fragments-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .fragment-month {
    align-self: flex-start;
    margin: 1.3rem 1.5rem .1rem 5.5rem;
    padding: 0;
    color: var(--muted);
    font-size: .74rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .fragment-item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.35rem 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }

  .fragment-item:last-child {
    border-bottom: 0;
  }

  .fragment-avatar,
  .fragment-avatar img {
    display: block;
    width: 3rem;
    height: 3rem;
  }

  .fragment-avatar img {
    border: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    border-radius: 7px;
    object-fit: cover;
  }

  .fragment-body {
    min-width: 0;
  }

  .fragment-author {
    margin-top: -.1rem;
    font-size: .96rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .fragment-author a,
  .fragment-expand,
  .fragment-comment-author,
  .fragment-comment-reply,
  .fragment-comments-more {
    color: var(--moment-blue);
  }

  .fragment-title {
    margin: .22rem 0 .12rem;
    color: var(--ink);
    font-size: .96rem;
    font-weight: 600;
    line-height: 1.55;
  }

  .fragment-title a:hover {
    color: var(--moment-blue);
  }

  .fragment-content-wrap {
    margin-top: .28rem;
  }

  .fragment-content {
    max-height: 9.48em;
    overflow: hidden;
    color: var(--ink);
    font-size: .96rem;
    line-height: 1.58;
    overflow-wrap: anywhere;
  }

  .fragment-content.is-expanded {
    max-height: none;
  }

  .fragment-content :global(p) {
    margin: 0 0 .4rem;
  }

  .fragment-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .fragment-content :global(a) {
    color: var(--accent-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .fragment-content :global(h1),
  .fragment-content :global(h2),
  .fragment-content :global(h3),
  .fragment-content :global(h4) {
    margin: .8em 0 .35em;
    font-size: 1.02rem;
    line-height: 1.45;
  }

  .fragment-content :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: .82rem;
  }

  .fragment-expand {
    display: none;
    margin: .3rem 0 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: .88rem;
  }

  .fragment-expand.is-visible {
    display: inline-flex;
  }

  .fragment-media {
    display: grid;
    gap: 4px;
    width: min(100%, 29rem);
    margin-top: .65rem;
  }

  .fragment-media[data-count='1'] {
    display: block;
    width: min(17rem, 100%);
  }

  .fragment-media[data-count='2'],
  .fragment-media[data-count='4'] {
    grid-template-columns: repeat(2, 1fr);
    width: min(20rem, 86%);
  }

  .fragment-media:not([data-count='1']):not([data-count='2']):not([data-count='4']) {
    grid-template-columns: repeat(3, 1fr);
  }

  .fragment-thumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 3px;
    background: color-mix(in srgb, var(--line) 40%, transparent);
    cursor: zoom-in;
  }

  .fragment-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .16s ease, filter .16s ease;
  }

  .fragment-media[data-count='1'] .fragment-thumb {
    width: fit-content;
    max-width: 100%;
    aspect-ratio: auto;
  }

  .fragment-media[data-count='1'] .fragment-thumb img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 22rem;
    object-fit: contain;
  }

  .fragment-thumb:hover img {
    filter: brightness(.96);
    transform: scale(1.018);
  }

  .fragment-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: .75rem;
    color: var(--muted);
    font-size: .76rem;
  }

  .fragment-meta-copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .7rem;
  }

  .fragment-meta-copy a:last-child {
    color: var(--moment-blue);
  }

  .fragment-meta a:hover {
    color: var(--moment-blue);
  }

  .fragment-action {
    display: inline-flex;
    width: 34px;
    height: 22px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    background: color-mix(in srgb, var(--line) 58%, transparent);
    color: var(--moment-blue);
    font-size: .85rem;
    font-weight: 700;
    letter-spacing: 2px;
    line-height: 1;
  }

  .fragment-action:hover {
    background: color-mix(in srgb, var(--line) 88%, transparent);
    color: var(--moment-blue);
  }

  .fragment-comments {
    position: relative;
    margin-top: .6rem;
    padding: .52rem .65rem;
    border-radius: 2px;
    background: color-mix(in srgb, var(--line) 34%, transparent);
    color: var(--ink);
    font-size: .84rem;
    line-height: 1.55;
  }

  .fragment-comments::before {
    position: absolute;
    top: -6px;
    left: 13px;
    width: 0;
    height: 0;
    border-right: 7px solid transparent;
    border-bottom: 7px solid color-mix(in srgb, var(--line) 34%, transparent);
    border-left: 7px solid transparent;
    content: '';
  }

  .fragment-comment + .fragment-comment {
    margin-top: .25rem;
  }

  .fragment-comment-author {
    font-weight: 650;
  }

  .fragment-comment-reply {
    margin-left: .3rem;
  }

  .fragment-comment-colon {
    margin-right: .2rem;
  }

  .fragment-comment-content {
    white-space: pre-line;
  }

  .fragment-comments-more {
    display: inline-block;
    margin-top: .35rem;
  }

  .fragment-lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .fragment-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fragment-lightbox::backdrop {
    background: rgba(0, 0, 0, .9);
  }

  .fragment-lightbox img {
    max-width: 94vw;
    max-height: 94vh;
    object-fit: contain;
  }

  .fragment-lightbox-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 1;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, .16);
    color: white;
    cursor: pointer;
    font-size: 1.4rem;
    line-height: 1;
  }

  @media (max-width: 768px) {
    .fragments-page {
      width: 100%;
      margin-top: 0;
      padding-bottom: 42px;
      border-right: 0;
      border-left: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .moments-cover {
      height: 205px;
    }

    .moments-cover h1 {
      top: 14px;
      left: 16px;
      font-size: .98rem;
    }

    .moments-identity {
      right: 16px;
      bottom: -31px;
      gap: 10px;
    }

    .moments-identity strong {
      font-size: 1.05rem;
      transform: translateY(-18px);
    }

    .moments-identity img {
      width: 72px;
      height: 72px;
    }

    .moments-signature {
      min-height: 59px;
      padding: 39px 16px 10px;
      font-size: .76rem;
    }

    .fragment-item {
      grid-template-columns: 2.65rem minmax(0, 1fr);
      gap: .75rem;
      padding: 1.15rem 1rem;
    }

    .fragment-avatar,
    .fragment-avatar img {
      width: 2.65rem;
      height: 2.65rem;
    }

    .fragment-media {
      width: 100%;
    }

    .fragment-month {
      margin: 1.1rem 1rem 0 4.4rem;
    }

    .fragment-title,
    .fragment-content {
      font-size: .95rem;
    }

    .fragment-content {
      line-height: 1.58;
    }

    .fragment-media[data-count='1'] {
      width: min(15rem, 100%);
    }

    .fragment-action {
      width: 44px;
      height: 36px;
    }
  }
</style>
