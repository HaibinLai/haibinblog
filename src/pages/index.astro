---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import FeaturedPosts from '../components/FeaturedPosts.astro';
import LeftNavigation from '../components/LeftNavigation.astro';
import RightSidebar from '../components/RightSidebar.astro';
import { postCardImage } from '../data/postImages';

const fragmentCategories = new Set(['fragments', 'life-fragments']);
const posts = (await getCollection(
  'posts',
  ({ data }) => !data.draft && ![data.category, ...data.categories]
    .some((category) => fragmentCategories.has(category.trim().toLowerCase())),
))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const base = import.meta.env.BASE_URL;
const postSlug = (post: (typeof posts)[number]) => post.data.slug ?? post.id.replace(/^wordpress\//, '');
---

<BaseLayout description="Haibin Lai's research notes and essays.">
  <div class="home-layout content-shell">
    <LeftNavigation posts={posts} />
    <section class="post-feed" aria-label="Writing">
      <FeaturedPosts posts={posts} />
      <p class="filter-status" id="feed-status" hidden></p>
      <div class="post-list">
      {posts.map((post) => {
        const slug = postSlug(post);
        return (
        <PostCard
          slug={slug}
          title={post.data.title}
          description={post.data.description}
          date={post.data.publishedAt}
          category={post.data.category}
          tags={post.data.tags}
          href={`${base}posts/${slug}/`}
          cardImage={postCardImage(post, base)}
        />
        );
      })}
        <p class="empty-filter" hidden>No writing matches this filter.</p>
      </div>
    </section>
    <RightSidebar posts={posts} />
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const cards = [...document.querySelectorAll('.post-card[data-post-slug]')];
    const featuredPosts = document.querySelector('.featured-posts');
    const params = new URLSearchParams(window.location.search);
    const tag = params.get('tag');
    const category = params.get('category');

    if (tag || category) {
      if (featuredPosts) featuredPosts.hidden = true;
      let visible = 0;
      cards.forEach((card) => {
        const tags = JSON.parse(card.dataset.tags || '[]');
        const matches = tag ? tags.includes(tag) : card.dataset.category === category;
        card.hidden = !matches;
        if (matches) visible += 1;
      });

      const filterStatus = document.querySelector('#feed-status');
      if (filterStatus) {
        const label = tag || category;
        filterStatus.textContent = `${label} · ${visible} ${visible === 1 ? 'post' : 'posts'}`;
        filterStatus.hidden = false;
      }
      document.querySelector('.empty-filter').hidden = visible !== 0;

      if (tag) {
        document.querySelectorAll('[data-tag-filter]').forEach((link) => {
          link.classList.toggle('is-active', link.dataset.tagFilter === tag);
        });
      }
    }

    const tree = document.querySelector('.left-navigation .nav-tree');
    const rootLink = tree?.querySelector('[data-nav-root]');
    const navLinks = [...(tree?.querySelectorAll('[data-post-slug]') ?? [])];
    const linksBySlug = new Map(navLinks.map((link) => [link.dataset.postSlug, link]));
    const desktopSidebar = window.matchMedia('(min-width: 1025px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeLink = null;
    let scheduled = false;

    const revealActiveLink = (link) => {
      if (!tree || !link) return;
      const treeRect = tree.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();
      const edge = 12;
      if (linkRect.top >= treeRect.top + edge && linkRect.bottom <= treeRect.bottom - edge) return;

      const linkTop = tree.scrollTop + linkRect.top - treeRect.top;
      const target = Math.max(0, linkTop - (tree.clientHeight - linkRect.height) / 2);
      tree.scrollTo({ top: target, behavior: reduceMotion ? 'auto' : 'smooth' });
    };

    const setActiveLink = (nextLink) => {
      if (!nextLink || nextLink === activeLink) return;
      [rootLink, ...navLinks].forEach((link) => {
        if (!link) return;
        const isActive = link === nextLink;
        link.classList.toggle('is-active', isActive);
        if (isActive) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      activeLink = nextLink;
      revealActiveLink(nextLink);
    };

    const updateActivePost = () => {
      if (!desktopSidebar.matches) {
        scheduled = false;
        return;
      }

      const visibleCards = cards.filter((card) => !card.hidden);
      if (visibleCards.length === 0) {
        setActiveLink(rootLink);
        scheduled = false;
        return;
      }

      const headerHeight = document.querySelector('.site-header')?.getBoundingClientRect().height ?? 62;
      const readingLine = headerHeight + 70;
      let activeCard = null;

      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        activeCard = visibleCards[visibleCards.length - 1];
      } else {
        for (const card of visibleCards) {
          if (card.getBoundingClientRect().top <= readingLine) activeCard = card;
          else break;
        }
      }

      setActiveLink(activeCard
        ? linksBySlug.get(activeCard.dataset.postSlug)
        : rootLink);
      scheduled = false;
    };

    const scheduleUpdate = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(updateActivePost);
    };

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate, { passive: true });
    window.addEventListener('pageshow', scheduleUpdate);
    updateActivePost();
  })();
</script>
