---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleNavigation from '../../components/ArticleNavigation.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import RightSidebar from '../../components/RightSidebar.astro';
import ViewCount from '../../components/ViewCount.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id.replace(/^wordpress\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const base = import.meta.env.BASE_URL;
const currentSlug = post.data.slug ?? post.id.replace(/^wordpress\//, '');
const languageOrder = { 'zh-CN': 0, en: 1 } as const;
const translationOptions = post.data.translationKey && post.data.language
  ? allPosts
      .filter((candidate) => (
        candidate.data.translationKey === post.data.translationKey
        && candidate.data.language
      ))
      .map((candidate) => {
        const slug = candidate.data.slug ?? candidate.id.replace(/^wordpress\//, '');
        return {
          language: candidate.data.language!,
          href: `${base}posts/${slug}/`,
          absoluteHref: new URL(`${base}posts/${slug}/`, Astro.site).href,
          title: candidate.data.title,
          active: slug === currentSlug,
        };
      })
      .sort((a, b) => languageOrder[a.language] - languageOrder[b.language])
  : [];
if (new Set(translationOptions.map(({ language }) => language)).size !== translationOptions.length) {
  throw new Error(`Translation group "${post.data.translationKey}" contains duplicate language entries.`);
}
const hasTranslationPair = translationOptions.length === 2;
const alternateLinks = hasTranslationPair
  ? translationOptions.map(({ language, absoluteHref }) => ({
      lang: language,
      href: absoluteHref,
    }))
  : [];
const { Content } = await render(post);
const publishedDate = post.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const updatedDate = post.data.updatedAt?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const authorName = ['GB', 'haibin'].includes(post.data.author) ? 'Haibin Lai' : post.data.author;
const citationKey = `lai-${post.id.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
const citation = `@online{${citationKey},\n  title={${post.data.title}},\n  author={Haibin Lai},\n  year={${post.data.publishedAt.getFullYear()}},\n  url={${Astro.url.href}},\n}`;
---

<BaseLayout
  title={`${post.data.title} | Haibin's Blog`}
  description={post.data.description}
  lang={post.data.language ?? 'zh-CN'}
  alternates={alternateLinks}
>
  <div class="article-page-shell content-shell">
    <ArticleNavigation title={post.data.title} />
    <article class="post-page">
    <header class="post-header">
      <div class="post-header-top">
        <p class="eyebrow">{post.data.category}</p>
        {hasTranslationPair && <LanguageSwitcher options={translationOptions} />}
      </div>
      <h1 id="article-title">{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <div class="post-info">
        <span>{authorName || 'Haibin Lai'}</span>
        <time datetime={post.data.publishedAt.toISOString()}>{publishedDate}</time>
        {updatedDate && <span>Updated {updatedDate}</span>}
        <span><ViewCount scope="page" value={post.data.viewCount ?? 0} /> views</span>
        <span>{post.data.commentCount} comments</span>
      </div>
    </header>
    <div class="article-layout">
      <div class="prose"><Content /></div>
    </div>
    <script>
      const renderMermaidDiagrams = async () => {
        const mermaidBlocks = [
          ...Array.from(document.querySelectorAll<HTMLElement>('.prose pre[data-language="mermaid"]')),
          ...Array.from(document.querySelectorAll<HTMLElement>('.prose pre code.language-mermaid'))
            .filter((code) => !code.closest('pre[data-language="mermaid"]')),
        ];
        if (!mermaidBlocks.length) return;

        const { default: mermaid } = await import('mermaid');
        const diagramWrappers = mermaidBlocks.map((code, index) => {
          const wrapper = document.createElement('div');
          wrapper.className = 'mermaid-diagram';
          wrapper.dataset.mermaidSource = code.textContent?.trim() || '';
          wrapper.dataset.mermaidId = `mermaid-diagram-${index}`;
          wrapper.textContent = wrapper.dataset.mermaidSource;
          (code.matches('code') ? code.closest('pre') : code)?.replaceWith(wrapper);
          return wrapper;
        });

        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'strict',
          theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
          flowchart: { htmlLabels: true, useMaxWidth: true },
        });

        try {
          await mermaid.run({ nodes: diagramWrappers });
        } catch (error) {
          // Keep a readable source fallback when a diagram contains unsupported syntax.
          console.warn('Mermaid diagram could not be rendered.', error);
          diagramWrappers.forEach((wrapper) => {
            wrapper.classList.add('mermaid-diagram--error');
            const source = wrapper.dataset.mermaidSource || '';
            const pre = document.createElement('pre');
            const code = document.createElement('code');
            code.className = 'language-mermaid';
            code.textContent = source;
            pre.append(code);
            wrapper.replaceChildren(pre);
          });
        }
      };

      void renderMermaidDiagrams();

      const tableWrappers: HTMLElement[] = [];

      document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table, index) => {
        const existingWrapper = table.parentElement?.closest<HTMLElement>('.article-table-scroll');
        if (existingWrapper) {
          tableWrappers.push(existingWrapper);
          return;
        }

        const wrapper = document.createElement('div');
        const caption = table.querySelector('caption')?.textContent?.trim();
        wrapper.className = 'article-table-scroll';
        wrapper.dataset.tableLabel = caption || `Scrollable table ${index + 1}`;
        table.before(wrapper);
        wrapper.append(table);
        tableWrappers.push(wrapper);
      });

      const updateScrollableTable = (wrapper: HTMLElement) => {
        const isScrollable = wrapper.scrollWidth > wrapper.clientWidth + 1;
        if (isScrollable) {
          wrapper.tabIndex = 0;
          wrapper.setAttribute('role', 'region');
          wrapper.setAttribute('aria-label', wrapper.dataset.tableLabel || 'Scrollable table');
        } else {
          wrapper.removeAttribute('tabindex');
          wrapper.removeAttribute('role');
          wrapper.removeAttribute('aria-label');
        }
      };

      const updateScrollableTables = () => tableWrappers.forEach(updateScrollableTable);
      requestAnimationFrame(updateScrollableTables);

      if ('ResizeObserver' in window) {
        const tableResizeObserver = new ResizeObserver((entries) => {
          entries.forEach((entry) => updateScrollableTable(entry.target as HTMLElement));
        });
        tableWrappers.forEach((wrapper) => tableResizeObserver.observe(wrapper));
      } else {
        window.addEventListener('resize', updateScrollableTables, { passive: true });
      }

      document.querySelectorAll<HTMLDetailsElement>('.prose details').forEach((details) => {
        details.addEventListener('toggle', () => requestAnimationFrame(updateScrollableTables));
      });
    </script>
    {post.data.showCitation && (
      <section class="citation">
        <h2>If you need to cite this post</h2>
        <p>Haibin Lai. ({publishedDate}). “{post.data.title}” [Blog post]. Retrieved from <a href={Astro.url.href}>{Astro.url.href}</a></p>
        <pre><code>{citation}</code></pre>
      </section>
    )}
    </article>
    <RightSidebar posts={allPosts} />
  </div>
</BaseLayout>
